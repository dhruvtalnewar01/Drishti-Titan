# ═══════════════════════════════════════════
# TITAN — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════

# === Google Gemini ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro

# === Zerodha Kite Connect ===
ZERODHA_API_KEY=your_kite_api_key
ZERODHA_API_SECRET=your_kite_api_secret
ZERODHA_USER_ID=your_zerodha_user_id
ZERODHA_TOTP_SECRET=your_totp_secret_key
ZERODHA_PASSWORD=your_zerodha_password

# === Groww Trading API ===
GROWW_API_KEY=your_groww_api_key
GROWW_API_SECRET=your_groww_api_secret

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=titan_db
POSTGRES_USER=titan
POSTGRES_PASSWORD=titan_secure_password_change_me
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# === ChromaDB ===
CHROMA_HOST=localhost
CHROMA_PORT=8000

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8080
JWT_SECRET_KEY=your_super_secret_jwt_key_change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Trading Configuration ===
TRADING_MODE=paper
DEFAULT_BROKER=zerodha
MAX_CAPITAL_ALLOCATION=100000
MAX_SINGLE_POSITION_PCT=5
MAX_TOTAL_EXPOSURE_PCT=40
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
ORDERS_PER_SECOND_LIMIT=8

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/titan.log
